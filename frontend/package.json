{
  "name": "shizuha-notes-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "npm run test:unit && npm run test:axios-security && npm run test:editor-security && playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:editor-security": "node scripts/verify-editor-security.mjs",
    "test:axios-security": "node scripts/verify-axios-security.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@shizuha/editor": "file:vendor/editor.tgz",
    "@shizuha/ui": "file:vendor/ui.tgz",
    "@tanstack/react-query": "^5.17.0",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "axios": "^1.20.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "lowlight": "^3.0.0",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.0",
